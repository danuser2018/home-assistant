# =============================================================================
# Security Service Configuration (security-service)
# =============================================================================

# Secret key used for signing authorization tokens (HMAC-SHA256)
SECURITY_HMAC_SECRET=dev-secret-key-change-in-prod

# Level of logging detail (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Token TTL in seconds (default 300 = 5 minutes)
TOKEN_TTL_SECONDS=300
